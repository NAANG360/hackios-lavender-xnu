# Large artifacts and local state are never committed.
artifacts/
refs/
work/

# Apple firmware and images
*.ipsw
*.dmg
*.im4p
*.simg
*.img
*.bin
# The board DTB is not a dump: the shim appends it so the ABL accepts the image.
!resources/lavender_dtb.bin

# Kernel/shim build outputs
kernel.development.*
*.o
*.a
*.dSYM/
*.unstripped
build/
out/
shim/out/
xnu/out/
__pycache__/

# Logs and dumps
*.log
*.txt
sweetlog*.bin
*.core
*.panic

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local secrets / personal data
*.pem
*.key
.env
