+	 * device, 3 (LAVENDER) first power the GDSC/clocks the GCC controls.
+	 */
 	PE_parse_boot_argn("sweetusb", &enabled, sizeof(enabled));
 	if (!enabled) {
 		return;
@@ -87,6 +190,13 @@ sweet_usb_probe(void)
 		printf("SWEET USB: GCC map failed\n");
 		return;
 	}
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	printf("SWEET USB: lavender DWC3 0x%08x QUSB2 v1 0x%08x (driver 0200, sweetusb=%d)\n",
+	    DWC3_PA, QUSB2_PA, enabled);
+	if (enabled >= 3) {
