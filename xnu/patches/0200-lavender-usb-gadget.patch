+#endif
 	gdscr = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
 	printf("SWEET USB: GDSC usb30_prim 0x%08x (%s)\n", gdscr, (gdscr & (1u << 31)) ? "on" : "off");
 	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
@@ -124,11 +234,21 @@ sweet_usb_probe(void)
 	if (phy == 0) {
 		return;
 	}
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	/* QUSB2 v1 (Linux phy-msm-qusb.c): PLL_STATUS 0x38 (bit 5 PLL lock),
+	 * PORT_TUNE1 0x80 (the DT init sequence writes 0xf8 there),
+	 * PORT_POWERDOWN 0xb4 (bit 0 POWER_DOWN), PORT_UTMI_CTRL2 0xc4. */
+	uint32_t pll = usb_rd(phy, 0x38), pd = usb_rd(phy, 0xb4);
+	printf("SWEET USB: QUSB2 PLL_STATUS 0x%08x (%s) PORT_TUNE1 0x%08x POWERDOWN 0x%08x (%s) UTMI_CTRL2 0x%08x\n",
+	    pll, (pll & (1u << 5)) ? "locked" : "NOT locked", usb_rd(phy, 0x80), pd,
+	    (pd & 1u) ? "powered down" : "powered", usb_rd(phy, 0xc4));
+#else
 	/* DT qcom,qusb-phy-reg-offset order (Linux phy-msm-qusb-v2.c): PORT_TUNE1 0x240,
 	 * PLL_COMMON_STATUS_ONE 0x1a0, PWR_CTRL1 0x210, INTR_CTRL 0x230,
 	 * PLL_CORE_INPUT_OVERRIDE 0x0a8, TEST1 0x254. */
 	printf("SWEET USB: QUSB2 PLL_STATUS 0x%08x PWR_CTRL1 0x%08x PORT_TUNE1 0x%08x TEST1 0x%08x\n",
 	    usb_rd(phy, 0x1a0), usb_rd(phy, 0x210), usb_rd(phy, 0x240), usb_rd(phy, 0x254));
+#endif
 }
 
