+#define CBCR_CLK_OFF            (1u << 31)
+
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+/*
+ * LAVENDER (SDM660; WHYRED/SDM636 shares the block). Addresses from the
+ * phone's own DTB (resources/lavender_dtb.bin): ssusb@a800000
+ * "qcom,dwc-usb3-msm" core_base 0x0a800000 (+0xfc100), dwc3@a800000
+ * (0xc8d0), qusb@c012000 "qcom,qusb2phy" major-rev 1 (QUSB2 v1, not v2),
+ * clock-controller@100000 "qcom,gcc-sdm660" (0x94000). GDSC and branch
+ * clock offsets from Linux drivers/clk/qcom/gcc-sdm660.c: usb_30_gdsc
+ * 0xf004, usb30_master 0xf008, usb30_sleep 0xf00c, usb30_mock_utmi
+ * 0xf010, cfg_noc_usb3_axi 0x5018, aggre2_usb3_axi 0xf03c,
+ * usb_phy_cfg_ahb2phy 0x6a004, rx0_usb2_clkref 0x88018 (voted).
+ * Entry order matters: [0] master, [3] cfg-noc-axi, [5] ahb2phy.
+ */
+#define GCC_PA                  0x00100000
+#define GCC_SIZE                0x00094000
+#define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on, bit 0: SW collapse */
+
+static const struct {
+	const char *name;
+	uint32_t    off;
+} usb_cbcr[] = {
+	{ "master", 0x0f008 },
+	{ "sleep", 0x0f00c },
+	{ "utmi", 0x0f010 },
+	{ "cfg-noc-axi", 0x05018 },
+	{ "aggre-axi", 0x0f03c },
+	{ "ahb2phy", 0x6a004 },
+	{ "clkref", 0x88018 },
+};
+
+#define DWC3_PA                 0x0a800000
+#define DWC3_SIZE               0x0000d000
+#define QUSB2_PA                0x0c012000
+#define QUSB2_SIZE              0x00000400
+#else
 #define GCC_PA                  0x00100000
 #define GCC_SIZE                0x00090000
 #define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
-#define CBCR_CLK_OFF            (1u << 31)
 
 static const struct {
 	const char *name;
@@ -61,6 +97,7 @@ static const struct {
 #define DWC3_SIZE               0x0000d000
 #define QUSB2_PA                0x088e2000
 #define QUSB2_SIZE              0x00000400
+#endif
 
 static uint32_t
 usb_rd(vm_offset_t base, uint32_t off)
@@ -70,14 +107,80 @@ usb_rd(vm_offset_t base, uint32_t off)
 	return v;
 }
 
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+/*
+ * sweetusb=3 (LAVENDER only, experimental): on lavender the shim is started
+ * from the recovery partition with Power + Volume Up, not by `fastboot
+ * boot`, so ABL may not leave the USB block powered as it does on sweet.
+ * This turns on what the GCC alone controls: the USB30 GDSC (clear
+ * SW_COLLAPSE, wait PWR_ON) and the branch clocks (CLK_ENABLE, wait for
+ * CLK_OFF to clear), each with a bounded wait. It does not touch the clock
+ * sources (RCG rates), the resets, the PMIC regulators of the QUSB2 PHY or
+ * the PHY tuning; if those were left off by ABL the probe still reports the
+ * controller as unusable and nothing else is attempted.
+ */
+#define GDSCR_SW_COLLAPSE       (1u << 0)
+#define GDSCR_PWR_ON            (1u << 31)
+#define CBCR_CLK_ENABLE         (1u << 0)
+
+static void
+usb_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+lavender_usb_power_up(vm_offset_t gcc)
+{
+	uint32_t v = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	int i;
+
+	if (!(v & GDSCR_PWR_ON)) {
+		usb_wr(gcc, GCC_USB30_PRIM_GDSCR, v & ~GDSCR_SW_COLLAPSE);
+		for (i = 0; i < 100 && !(usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & GDSCR_PWR_ON); i++) {
+			delay(10);
+		}
+		v = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+		printf("SWEET USB: GDSC usb30 power-up %s (0x%08x)\n",
+		    (v & GDSCR_PWR_ON) ? "ok" : "TIMEOUT", v);
+		if (!(v & GDSCR_PWR_ON)) {
+			return;
+		}
+	}
+	for (unsigned c = 0; c < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); c++) {
+		v = usb_rd(gcc, usb_cbcr[c].off);
+		if (!(v & CBCR_CLK_OFF)) {
+			continue;
+		}
+		usb_wr(gcc, usb_cbcr[c].off, v | CBCR_CLK_ENABLE);
+		for (i = 0; i < 100 && (usb_rd(gcc, usb_cbcr[c].off) & CBCR_CLK_OFF); i++) {
+			delay(10);
+		}
+		v = usb_rd(gcc, usb_cbcr[c].off);
+		printf("SWEET USB: clk %-12s enable %s (0x%08x)\n", usb_cbcr[c].name,
+		    (v & CBCR_CLK_OFF) ? "STILL OFF" : "ok", v);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_LAVENDER */
