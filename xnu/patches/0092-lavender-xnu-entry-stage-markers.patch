From 6f5de9b9d9d7f6e7d9d8af4a1c7c3e9d8c1a6b20 Mon Sep 17 00:00:00 2001
Subject: [PATCH] lavender: add XNU-owned framebuffer entry-stage markers

The shim's final "XNU jumping" line is emitted before it branches to the
Mach-O LC_UNIXTHREAD PC. Add two tiny, persistent marks to the audited
Lavender splash framebuffer:

  green: start_first_cpu has executed, while MMU is still off
  blue:  bootstrap MMU has been enabled and the V=P framebuffer mapping works

The existing arm_init() logo remains the third milestone and clears these
diagnostic marks when reached. This patch does not bypass CPU/granule gates,
alter the memory map, or touch persistent storage.

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -1,3 +1,24 @@
 mov x20, x0
 mov x21, #0
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	/*
+	 * Stage 1: XNU's first-CPU entry stub is running with MMU off.
+	 * Paint a 16x16 green marker near the lower-left edge of the
+	 * known 1080x2340 physical framebuffer. x0 is free: boot_args
+	 * was saved in x20 above.
+	 */
+	MOV64	x0, 0x9d400000 + (2308 * 4320) + 64
+	MOV64	x1, 0xff00ff00
+	mov	x2, #16
+	mov	x4, #4256
+1:
+	mov	x3, #16
+2:
+	str	w1, [x0], #4
+	subs	x3, x3, #1
+	b.ne	2b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	1b
+	dsb	sy
+#endif
 // Set low reset vector before attempting any loads
@@ -1,2 +1,23 @@
 #endif /* !VMAPPLE */
 
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	/*
+	 * Stage 2: the MMU and caches are enabled. The Lavender early
+	 * identity/V=P mapping must now make this same framebuffer
+	 * reachable at its physical address.
+	 */
+	MOV64	x0, 0x9d400000 + (2308 * 4320) + 160
+	MOV64	x1, 0xff0000ff
+	mov	x2, #16
+	mov	x4, #4256
+3:
+	mov	x3, #16
+4:
+	str	w1, [x0], #4
+	subs	x3, x3, #1
+	b.ne	4b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	3b
+	dsb	sy
+#endif
