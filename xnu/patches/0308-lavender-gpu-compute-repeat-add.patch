diff --git a/bsd/dev/lavender_gpu.c b/bsd/dev/lavender_gpu.c
index db26dbc..4f14dcb 100644
--- a/bsd/dev/lavender_gpu.c
+++ b/bsd/dev/lavender_gpu.c
@@ -1500,8 +1500,17 @@ lavender_gpu_thread(__unused void *arg, __unused wait_result_t wr_)
