+{
+	for (int s = 0; s < 32; s += 8) {
+		int a = (int)((got >> s) & 0xff), b = (int)((want >> s) & 0xff);
+		if (a - b > tol || b - a > tol) {
+			return 0;
+		}
+	}
+	return 1;
