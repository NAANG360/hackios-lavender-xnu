 }
diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index 7543c7c..03ce5b2 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -140,6 +140,8 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
  */
 #if defined(ARM64_BOARD_CONFIG_LAVENDER)
 #define LSP_CORE_PA     0x0800f000u
+#define LSP_CHNLS_PA    0x08400000u
+#define LSP_CFG_PA      0x0800a000u
 #define LSP_OBS_PA      0x09400000u
 #define LSP_APID_MAP    0x800u
 #define LSP_OBS_STRIDE  0x8000u
@@ -149,7 +151,9 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 #define LSP_ARB_END     0x50000000u
 
 static vm_offset_t lsp_core;
+static vm_offset_t lsp_cfg;
 static vm_offset_t lsp_chan[LSP_MAX_APIDS];
+static vm_offset_t lsp_wchan[LSP_MAX_APIDS];
 static IOLock *lsp_lock;
 static bool lsp_attempted, lsp_ready;
 static bool lsp_poisoned[LSP_MAX_APIDS];
@@ -194,8 +198,9 @@ lsp_init(void)
 		return -1;
 	}
 	lsp_core = ml_io_map(LSP_CORE_PA, 0x1000);
-	if (!lsp_core) {
-		printf("SWEET AUDIO: lavender SPMI core map failed\n");
+	lsp_cfg = ml_io_map(LSP_CFG_PA, 0x1000);
+	if (!lsp_core || !lsp_cfg) {
+		printf("SWEET AUDIO: lavender SPMI core/cfg map failed\n");
 		return -1;
 	}
 	version = sp_rd(lsp_core, 0);
@@ -259,6 +264,69 @@ sweet_spmi_lavender_read(unsigned sid, unsigned addr, uint8_t *out)
 	IOLockUnlock(lsp_lock);
 	return -1;
 }
+/*
+ * 0510b: guarded write path (PMIC arbiter v2/v3 EXT_WRITEL).
+ * Only SID 3 / peripheral 0xf0 and the three DIG spare registers are allowed
+ * for now: the caller writes a pattern, reads it back and restores. The APID
+ * must be APPS-owned (EE 0); the RW channel is at chnls + 0x8000 * apid.
+ */
+int
+sweet_spmi_lavender_write(unsigned sid, unsigned addr, uint8_t val)
+{
+	unsigned off;
+	uint16_t apid;
+	vm_offset_t chan;
+	uint32_t cmd, status;
+
+	if (lsp_init() != 0 || sid != 3 || (addr >> 8) != 0xf0 ||
+	    (addr & 0xffu) < 0x70 || (addr & 0xffu) > 0x72) {
+		return -1;
+	}
+	IOLockLock(lsp_lock);
+	apid = lsp_find_apid((uint16_t)((sid << 8) | (addr >> 8)));
+	if (apid == LSP_NO_APID || lsp_poisoned[apid]) {
+		IOLockUnlock(lsp_lock);
+		return -1;
+	}
+	if ((sp_rd(lsp_cfg, 0x700u + 4u * apid) & 7u) != 0u) {
+		printf("SWEET AUDIO: lavender SPMI APID %u is not APPS-owned\n",
+		    apid);
+		IOLockUnlock(lsp_lock);
+		return -1;
+	}
+	if (lsp_wchan[apid] == 0) {
+		lsp_wchan[apid] = ml_io_map(LSP_CHNLS_PA +
+		    LSP_OBS_STRIDE * apid, 0x1000);
+	}
+	chan = lsp_wchan[apid];
+	if (chan == 0) {
+		IOLockUnlock(lsp_lock);
+		return -1;
+	}
+	*(volatile uint32_t *)(chan + 0x10) = val;      /* WDATA0 */
+	cmd = (0u << 27) | ((addr & 0xffu) << 4);       /* EXT_WRITEL, BC=0 */
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(chan + 0x00) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (off = 0; off < 1000; off++) {
+		status = sp_rd(chan, 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				printf("SWEET AUDIO: lavender SPMI write error "
+				    "status %08x addr %#x\n", status, addr);
+				IOLockUnlock(lsp_lock);
+				return -1;
+			}
+			IOLockUnlock(lsp_lock);
+			return 0;
+		}
+		delay(1);
+	}
+	lsp_poisoned[apid] = true;
+	printf("SWEET AUDIO: lavender SPMI write timeout addr %#x\n", addr);
+	IOLockUnlock(lsp_lock);
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_LAVENDER */
 
 #endif /* ARM64_BOARD_CONFIG_SWEET */
