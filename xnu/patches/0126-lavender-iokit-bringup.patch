--- a/iokit/Kernel/IOStartIOKit.cpp
+++ b/iokit/Kernel/IOStartIOKit.cpp
@@ -61,6 +61,14 @@ void IORegistrySetOSBuildVersion(char * build_version);
 void IORecordProgressBackbuffer(void * buffer, size_t size, uint32_t theme);
 
 extern void OSlibkernInit(void);
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+extern void sweet_early_trace_startup(unsigned int event, uintptr_t a,
+    uintptr_t b, uintptr_t c, uintptr_t d, uintptr_t e);
+#define LAVENDER_IOKIT_TRACE(event) \
+    sweet_early_trace_startup((event), 0, 0, 0, 0, 0)
+#else
+#define LAVENDER_IOKIT_TRACE(event) do { } while (0)
+#endif
 
 void iokit_post_constructor_init(void);
 
@@ -143,24 +151,32 @@ InitIOKit(void *dtTop)
 	// of iokit basic service initialisation, or better we have IOLib stuff
 	// initialise as basic OS services.
 	//
+	LAVENDER_IOKIT_TRACE(115); /* InitIOKit entered */
 	IOLibInit();
+	LAVENDER_IOKIT_TRACE(116); /* IOLibInit returned */
 	OSlibkernInit();
+	LAVENDER_IOKIT_TRACE(117); /* OSlibkernInit returned */
 	IOMachPortInitialize();
+	LAVENDER_IOKIT_TRACE(118); /* Mach port initialization returned */
 
 	gIOProgressBackbufferKey  = OSSymbol::withCStringNoCopy(kIOProgressBackbufferKey);
 	gIORemoveOnReadProperties = OSSet::withObjects((const OSObject **) &gIOProgressBackbufferKey, 1);
 
 	interruptAccountingInit();
+	LAVENDER_IOKIT_TRACE(119); /* IOKit globals and interrupt accounting ready */
 
 	gRootNub = new IOPlatformExpertDevice;
 	if (__improbable(gRootNub == NULL)) {
 		panic("Failed to allocate IOKit root nub");
 	}
+	LAVENDER_IOKIT_TRACE(120); /* IOKit root nub allocated */
 	bool ok = gRootNub->init(dtTop);
 	if (__improbable(!ok)) {
 		panic("Failed to initialize IOKit root nub");
 	}
+	LAVENDER_IOKIT_TRACE(121); /* IOKit root nub initialized */
 	gRootNub->attach(NULL);
+	LAVENDER_IOKIT_TRACE(122); /* IOKit root nub attached */
 
 	/* If the bootstrap segment set up a function to record startup
 	 * extensions, call it now.
@@ -168,11 +184,13 @@ InitIOKit(void *dtTop)
 	if (record_startup_extensions_function) {
 		record_startup_extensions_function();
 	}
+	LAVENDER_IOKIT_TRACE(123); /* InitIOKit returned */
 }
 
 void
 ConfigureIOKit(void)
 {
+	LAVENDER_IOKIT_TRACE(124); /* ConfigureIOKit entered */
 	assert(gRootNub != NULL);
 	gRootNub->configureDefaults();
 }
