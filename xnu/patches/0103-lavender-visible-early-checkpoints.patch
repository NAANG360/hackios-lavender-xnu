diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -152,6 +152,96 @@
 #define LAVENDER_FB_ALIAS_OFFSET (LAVENDER_FB_BASE - LAVENDER_FB_ALIAS_PA_BASE)
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)LAVENDER_FB_BASE;
 static volatile uint32_t *early_guard_cell;
+extern unsigned char iso_font[256 * 16];
+
+#define LAVENDER_CONSOLE_TOP 600u
+#define LAVENDER_CONSOLE_CHAR_W 8u
+#define LAVENDER_CONSOLE_CHAR_H 16u
+static unsigned int lavender_console_row;
+static unsigned int lavender_console_col;
+static unsigned int lavender_console_started;
+
+static void
+lavender_console_clear(void)
+{
+	for (unsigned int y = LAVENDER_CONSOLE_TOP; y < LAVENDER_FB_HEIGHT; y++) {
+		volatile uint32_t *line = early_fb + y * LAVENDER_FB_STRIDE;
+		for (unsigned int x = 0; x < LAVENDER_FB_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+	lavender_console_row = 0;
+	lavender_console_col = 0;
+}
+
+static void
+lavender_console_newline(void)
+{
+	lavender_console_col = 0;
+	lavender_console_row++;
+}
+
+static void
+lavender_console_putc(char c)
+{
+	if (c == '\r') {
+		lavender_console_col = 0;
+		return;
+	}
+	if (c == '\n' || lavender_console_col >= LAVENDER_FB_WIDTH / LAVENDER_CONSOLE_CHAR_W) {
+		lavender_console_newline();
+		if (c == '\n') {
+			return;
+		}
+	}
+	if (lavender_console_row >=
+	    (LAVENDER_FB_HEIGHT - LAVENDER_CONSOLE_TOP) / LAVENDER_CONSOLE_CHAR_H) {
+		return;
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		volatile uint32_t *line = early_fb +
+		    (LAVENDER_CONSOLE_TOP + lavender_console_row * LAVENDER_CONSOLE_CHAR_H + gy) *
+		    LAVENDER_FB_STRIDE + lavender_console_col * LAVENDER_CONSOLE_CHAR_W;
+		for (unsigned int gx = 0; gx < 8; gx++) {
+			if (glyph[gy] & (1u << gx)) {
+				line[gx] = 0xffffffffu;
+			}
+		}
+	}
+	lavender_console_col++;
+}
+
+static void
+lavender_console_string(const char *s)
+{
+	while (*s) {
+		lavender_console_putc(*s++);
+	}
+}
+
+static void
+lavender_console_mark(unsigned int stage, const char *label)
+{
+	if (!lavender_console_started) {
+		lavender_console_started = 1;
+		lavender_console_clear();
+		lavender_console_string("LAVENDER XNU VERBOSE BOOT\n");
+		lavender_console_string("LAST COMPLETED CHECKPOINTS:\n");
+	}
+	lavender_console_putc('[');
+	if (stage < 10) {
+		lavender_console_putc('0');
+	} else {
+		lavender_console_putc((char)('0' + stage / 10));
+		stage %= 10;
+	}
+	lavender_console_putc((char)('0' + stage));
+	lavender_console_string("] ");
+	lavender_console_string(label);
+	lavender_console_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
 
