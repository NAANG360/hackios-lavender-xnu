+			ud_le16(b + 8, (uint16_t)total);
+			ud_le16(b + 10, 12);
+			ud_le32(b + 12, NCM_NDP16_NOCRC_SIG);
+			ud_le16(b + 16, 16);
+			ud_le16(b + 18, 0);
+			ud_le16(b + 20, 28);
+			ud_le16(b + 22, (uint16_t)len);
+			ud_le16(b + 24, 0);
+			ud_le16(b + 26, 0);
