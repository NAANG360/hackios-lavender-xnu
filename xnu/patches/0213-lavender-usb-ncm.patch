+/*
+ * 0213: an OUT NTB16 (CDC NCM 1.0, 3.2/3.3): NTH16 "NCMH" (header length 12,
+ * sequence, block length, first NDP index), then NDP16 "NCM0" tables of
+ * (datagram index, length) pairs ended by a zero pair, chained by
+ * wNextNdpIndex. Everything is bounds-checked against the block; a bad block
+ * is counted and dropped.
+ */
+#define NCM_NTH16_SIG           0x484d434eu     /* "NCMH" */
+#define NCM_NDP16_NOCRC_SIG     0x304d434eu     /* "NCM0" */
+
+static void
+ud_ncm_rx(const uint8_t *b, uint32_t len)
+{
+	if (len < 12 || ud_rd32(b) != NCM_NTH16_SIG || ud_rd16(b + 4) != 12) {
+		ud.ntb_bad++;
+		return;
+	}
+	uint32_t blk = ud_rd16(b + 8);
+	if (blk == 0 || blk > len) {
+		blk = len;
+	}
+	uint32_t ndp = ud_rd16(b + 10);
+	for (unsigned tables = 0; ndp != 0 && tables < 8; tables++) {
+		if (ndp < 12 || (ndp & 3) || ndp + 8 > blk || ud_rd32(b + ndp) != NCM_NDP16_NOCRC_SIG) {
+			ud.ntb_bad++;
+			return;
+		}
+		uint32_t ndp_len = ud_rd16(b + ndp + 4);
+		if (ndp_len < 16 || ndp + ndp_len > blk) {
+			ud.ntb_bad++;
+			return;
+		}
+		for (uint32_t e = ndp + 8; e + 4 <= ndp + ndp_len; e += 4) {
+			uint32_t idx = ud_rd16(b + e), dlen = ud_rd16(b + e + 2);
+			if (idx == 0 || dlen == 0) {
+				break;
+			}
+			if (idx + dlen > blk) {
+				ud.ntb_bad++;
+				break;
+			}
+			ud_input_frame(b + idx, dlen);
+		}
+		ndp = ud_rd16(b + ndp + 6);
+	}
+}
+
+static void
+ud_rx_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	ud_sync(UD_TRB_RX, 16);
+	uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
+	ud_sync(UD_RX, UD_FRAME_MAX);
+	if (ud.ncm) {
+		ud_ncm_rx((const uint8_t *)(ud.dma + UD_RX), len);
+	} else {
+		ud_input_frame((const uint8_t *)(ud.dma + UD_RX), len);
+	}
+	if (ud.configured) {
+		ud_rx_arm();
+	}
 }
 
