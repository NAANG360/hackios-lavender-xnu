+/*
+ * 0213: CONNECTION_SPEED_CHANGE (bergamota 0108, Linux f_ecm/f_ncm): some
+ * hosts keep the link down until they get it. Bit rate as Linux
+ * gether_bitrate() reports at high speed.
+ */
+static void
+ud_notify_speed(void)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	const uint32_t rate = 13u * 512u * 8u * 1000u * 8u;
+	n[0] = 0xa1; n[1] = 0x2a;       /* CONNECTION_SPEED_CHANGE */
+	n[2] = 0; n[3] = 0;
+	n[4] = 0; n[5] = 0;             /* interface 0 */
+	n[6] = 8; n[7] = 0;
+	for (int i = 0; i < 4; i++) {
+		n[8 + i] = (uint8_t)(rate >> (8 * i));
+		n[12 + i] = (uint8_t)(rate >> (8 * i));
+	}
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 16, TRBCTL_NORMAL);
+}
+
+/* First notification when the data interface goes to alt 1. */
+static void
+ud_notify_start(void)
+{
+	ud.notify_stage = 1;
+	if (ud.ncm) {
+		ud_notify_speed();
+	} else {
+		ud_notify_connected();
+	}
+}
+
+/* The interrupt endpoint finished a notification: send the second one. */
+static void
+ud_notify_next(void)
+{
+	if (ud.notify_stage != 1 || !ud.configured) {
+		return;
+	}
+	ud.notify_stage = 2;
+	if (ud.ncm) {
+		ud_notify_connected();
+	} else {
+		ud_notify_speed();
+	}
+}
+
+/* ---- 0213: NCM class requests (USB CDC NCM 1.0, 6.2) ---- */
+#define NCM_NTB_MAX             0x800   /* = UD_FRAME_MAX: the IN and OUT NTB buffers */
+
+static void
+ud_le16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);
+}
+
+static void
+ud_le32(uint8_t *p, uint32_t v)
+{
+	ud_le16(p, (uint16_t)v); ud_le16(p + 2, (uint16_t)(v >> 16));
+}
+
+static uint16_t
+ud_rd16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static uint32_t
+ud_rd32(const uint8_t *p)
+{
+	return (uint32_t)ud_rd16(p) | (uint32_t)ud_rd16(p + 2) << 16;
+}
+
+/* Returns false to stall; *n = bytes of the IN data stage. */
+static bool
+ud_ncm_request(uint8_t req, uint16_t value, uint16_t length, uint8_t *data, uint32_t *n)
+{
+	switch (req) {
+	case 0x80:                      /* GET_NTB_PARAMETERS */
+		memset(data, 0, 28);
+		ud_le16(data + 0, 28);
+		ud_le16(data + 2, 1);           /* NTB16 only */
+		ud_le32(data + 4, NCM_NTB_MAX); /* dwNtbInMaxSize */
+		ud_le16(data + 8, 4);           /* wNdpInDivisor */
+		ud_le16(data + 12, 4);          /* wNdpInAlignment */
+		ud_le32(data + 16, NCM_NTB_MAX);/* dwNtbOutMaxSize */
+		ud_le16(data + 20, 4);          /* wNdpOutDivisor */
+		ud_le16(data + 24, 4);          /* wNdpOutAlignment */
+		*n = 28;
+		return true;
+	case 0x83:                      /* GET_NTB_FORMAT */
+		data[0] = 0; data[1] = 0;
+		*n = 2;
+		return true;
+	case 0x84:                      /* SET_NTB_FORMAT: NTB16 only */
+		return value == 0;
+	case 0x85:                      /* GET_NTB_INPUT_SIZE */
+		ud_le32(data, NCM_NTB_MAX);
+		*n = 4;
+		return true;
+	case 0x86:                      /* SET_NTB_INPUT_SIZE: we never send more than one datagram per NTB */
+	case 0x43:                      /* SET_ETHERNET_PACKET_FILTER */
+		return true;
+	default:
+		return length == 0;
+	}
+}
