-#if defined(SWEET)
+#if defined(SWEET) || defined(ARM64_BOARD_CONFIG_LAVENDER)
 void sweet_early_mark(unsigned int stage, const char *label);
 void sweet_early_putc(char c);
 void sweet_early_panic(const char *fmt, va_list *args);
 void sweet_early_relocate(uint64_t base);
 void sweet_early_disable(void);
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+void sweet_early_guard_init(uintptr_t boot_args_kva);
+#else
+static inline void sweet_early_guard_init(uintptr_t boot_args_kva) { (void)boot_args_kva; }
+#endif
 #else
 static inline void sweet_early_mark(unsigned int stage, const char *label)
 {
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 42362c5..7192b46 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -347,6 +347,9 @@ arm_init(
