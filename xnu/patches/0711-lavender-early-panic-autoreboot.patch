From: port_ios lavender
Subject: [PATCH 0711] lavender: auto-reboot 15 s after SWEET EARLY PANIC via PSCI_SYSTEM_RESET

On Redmi Note 7 units with a broken power button, an infinite wfe() halt in
sweet_early_panic() traps the device on the panic screen until the battery
drains. Wait 15 seconds using CNTPCT_EL0/CNTFRQ_EL0 (enough time to read or
photograph the panic message) and then issue PSCI_SYSTEM_RESET (0x84000009)
via SMC so the board reboots cleanly even before MMIO/timers/keys are up.

diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 7929b75..c8a003d 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -187,7 +187,34 @@ sweet_early_panic(const char *fmt, va_list *args)
 	va_end(copy);
 	sweet_early_putc('\n');
 	__asm__ volatile("dsb sy" ::: "memory");
-#if defined(ARM64_BOARD_CONFIG_SANTONI) || defined(SANTONI) || defined(ARM64_BOARD_CONFIG_LAVENDER) || defined(LAVENDER)
+#if defined(ARM64_BOARD_CONFIG_LAVENDER) || defined(LAVENDER)
+	sweet_early_string("\nLAVENDER: auto-rebooting in 15s (PSCI_SYSTEM_RESET)...\n");
+	__asm__ volatile("dsb sy" ::: "memory");
+	{
+		uint64_t freq = 0, start = 0, cur = 0;
+		__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(freq));
+		if (freq == 0) {
+			freq = 19200000ULL;
+		}
+		__asm__ volatile("isb; mrs %0, cntpct_el0" : "=r"(start));
+		uint64_t deadline = start + freq * 15ULL;
+		do {
+			__asm__ volatile("isb; mrs %0, cntpct_el0" : "=r"(cur));
+		} while (cur < deadline);
+		register uint64_t x0 __asm__("x0") = 0x84000009ULL; /* PSCI_SYSTEM_RESET */
+		register uint64_t x1 __asm__("x1") = 0;
+		register uint64_t x2 __asm__("x2") = 0;
+		register uint64_t x3 __asm__("x3") = 0;
+		__asm__ volatile("dsb sy; smc #0"
+		    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+		    :
+		    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+		      "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	}
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+#elif defined(ARM64_BOARD_CONFIG_SANTONI) || defined(SANTONI)
 	for (;;) {
 		__asm__ volatile("wfe");
 	}
