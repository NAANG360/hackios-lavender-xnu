From: port_ios lavender
Subject: [PATCH 0231] lavender: touch reads only the active slots; slower idle poll; line-rise stats

First device run of 0230 (live-touch-0230): touch works - setup screens,
home screen and icons respond - with 0 I2C errors, but an idle 12-byte
read takes ~13.9 ms and a full 65-byte frame up to ~65-70 ms, and the
idle loop (one read every ~25 ms) keeps about half a core busy. The
extra ~74 us per bit is the released lines rising through the pad pull-up.

- While touched, read up to the highest active slot plus one record
  (12 bytes for one finger) instead of the full frame: 4-5x more
  reports during a drag.
- Idle poll every sweetouchidle ms (default 25, was 10).
- The 10 s stats also report the average line-rise wait per release,
  to size the move to the hardware QUP I2C.

diff --git a/bsd/dev/santoni_touch.c b/bsd/dev/santoni_touch.c
index 28de9d8..9714fbe 100644
--- a/bsd/dev/santoni_touch.c
+++ b/bsd/dev/santoni_touch.c
@@ -184,6 +184,8 @@ pin_read(struct touch_pin *p)
  */
 static uint64_t touch_abs_per_us;
 static uint32_t touch_half_bit_us = TOUCH_I2C_DELAY_US;
+/* 0231: microseconds spent waiting for released lines to rise (pull-up) */
+static uint32_t touch_rise_us, touch_rise_n;
 
 static void
 touch_spin_us(uint32_t us)
@@ -234,11 +236,13 @@ sda_release(void)
 	int i;
 
 	pin_in(&touch_sda);
+	touch_rise_n++;
 	for (i = 0; i < TOUCH_LINE_WAIT_US; i++) {
 		if (pin_read(&touch_sda)) {
 			return 1;
 		}
 		touch_spin_us(1);
+		touch_rise_us++;
 	}
 	return 0;
 }
@@ -249,11 +253,13 @@ scl_release(void)
 	int i;
 
 	pin_in(&touch_scl);
+	touch_rise_n++;
 	for (i = 0; i < TOUCH_LINE_WAIT_US; i++) {
 		if (pin_read(&touch_scl)) {
 			return 1;
 		}
 		touch_spin_us(1);
+		touch_rise_us++;
 	}
 	return 0;
 }
@@ -1158,9 +1164,15 @@ santoni_touch_thread(void *arg, wait_result_t wr)
 	uint64_t st_start = 0, st_sum = 0, st_max = 0;
 	unsigned st_frames = 0, st_full = 0, st_err = 0, st_events = 0, st_quiet = 0;
 	unsigned contacts = 0;
+	unsigned top_slot = 0;          /* 0231: highest active slot (1-based), 0 = none */
+	uint32_t idle_ms = 25;
 
 	(void)arg;
 	(void)wr;
+	(void)PE_parse_boot_argn("sweetouchidle", &idle_ms, sizeof(idle_ms));
+	if (idle_ms < 2u || idle_ms > 200u) {
+		idle_ms = 25;
+	}
 	{
 		uint32_t us = 0;
 
@@ -1227,7 +1239,21 @@ santoni_touch_thread(void *arg, wait_result_t wr)
 		 * so 12 bytes (slots 1-2) are enough to see it; the full 65-byte
 		 * frame is read only while something is down.
 		 */
-		int len = contacts ? (int)sizeof(buf) : 12;
+		/*
+		 * 0231: a contact's record sits at its slot (record i = slot
+		 * i + 1), so read up to the highest active slot plus one more
+		 * record for a new finger: one finger is 12 bytes (~14 ms) instead
+		 * of the 65-byte frame (~65 ms), four to five times more reports
+		 * during a drag. 12 bytes still cover the first finger when idle.
+		 */
+		int len = 6 * (int)(top_slot + 1u);
+
+		if (len < 12) {
+			len = 12;
+		}
+		if (len > (int)sizeof(buf)) {
+			len = (int)sizeof(buf);
+		}
 		uint64_t f0 = mach_absolute_time();
 
 		err = nvt_read_fw(touch_fw_addr, 0x00, buf, len);
@@ -1281,25 +1307,31 @@ santoni_touch_thread(void *arg, wait_result_t wr)
 				}
 			}
 			contacts = 0;
+			top_slot = 0;
 			for (i = 0; i < 10u; i++) {
-				contacts += active[i] ? 1u : 0u;
+				if (active[i]) {
+					contacts++;
+					top_slot = i + 1u;
+				}
 			}
 		}
 		if (mach_absolute_time() - st_start >= touch_abs_per_us * 10000000ull) {
 			/* print while touches happen, and for the first minute */
 			if (st_events || st_err || st_quiet < 6u) {
 				printf("WHYRED TOUCH: 10s frames %u (full %u) err %u avg %llu us max %llu us "
-				    "events %u contacts %u\n", st_frames, st_full, st_err,
-				    st_frames ? touch_abs_to_us(st_sum / st_frames) : 0ull,
-				    touch_abs_to_us(st_max), st_events, contacts);
+				    "events %u contacts %u; line rise %u us per release\n", st_frames, st_full,
+				    st_err, st_frames ? touch_abs_to_us(st_sum / st_frames) : 0ull,
+				    touch_abs_to_us(st_max), st_events, contacts,
+				    touch_rise_n ? touch_rise_us / touch_rise_n : 0u);
 			}
 			st_quiet = st_events ? 0u : st_quiet + 1u;
 			st_frames = st_full = st_err = st_events = 0;
 			st_sum = st_max = 0;
+			touch_rise_us = touch_rise_n = 0;
 			st_start = mach_absolute_time();
 		}
-		/* about 500 Hz while touched, 100 Hz when idle (blocking sleep) */
-		delay(contacts ? 2000 : 10000);
+		/* 2 ms between reads while touched; sweetouchidle ms (25) when idle */
+		delay(contacts ? 2000 : (int)(idle_ms * 1000u));
 	}
 }
 
