+/* Append compact numbers without depending on printf during early startup. */
+static void
+lavender_trace_append_char(char *buffer, unsigned int *length, char c)
+{
+	if (*length < 127u) {
+		buffer[(*length)++] = c;
+	}
+}
+
+static void
+lavender_trace_append_text(char *buffer, unsigned int *length, const char *text)
+{
+	while (*text) {
+		lavender_trace_append_char(buffer, length, *text++);
+	}
+}
+
+static void
+lavender_trace_append_decimal(char *buffer, unsigned int *length, uint64_t value)
+{
+	char digits[20];
+	unsigned int count = 0;
+	do {
+		digits[count++] = (char)('0' + (value % 10u));
+		value /= 10u;
+	} while (value && count < sizeof(digits));
+	while (count) {
+		lavender_trace_append_char(buffer, length, digits[--count]);
+	}
+}
+
+static void
+lavender_trace_append_hex(char *buffer, unsigned int *length, uint64_t value)
+{
+	static const char hex[] = "0123456789ABCDEF";
+	lavender_trace_append_text(buffer, length, "0x");
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		lavender_trace_append_char(buffer, length, hex[(value >> shift) & 0xfu]);
+	}
+}
+
+/*
+ * Keep a single rolling status line below the ordinary checkpoint history.
+ * Do not publish these sub-events to the Guardian cell: they must not extend
+ * its 60-second no-progress deadline or collide with the stage-20 high bit.
+ */
+void
+sweet_early_trace_startup(unsigned int event, uintptr_t a, uintptr_t b,
+    uintptr_t c, uintptr_t d, uintptr_t e)
+{
+	char text[128];
+	unsigned int length = 0;
+	switch (event) {
+	case 1:
+		lavender_trace_append_text(text, &length, "TABLE n=");
+		lavender_trace_append_decimal(text, &length, a);
+		lavender_trace_append_text(text, &length, " bytes=");
+		lavender_trace_append_decimal(text, &length, b);
+		lavender_trace_append_text(text, &length, " start=");
+		lavender_trace_append_hex(text, &length, c);
+		lavender_trace_append_text(text, &length, " end=");
+		lavender_trace_append_hex(text, &length, d);
+		break;
+	case 2:
+		lavender_trace_append_text(text, &length, "QSORT BEGIN n=");
+		lavender_trace_append_decimal(text, &length, a);
+		break;
+	case 3:
+		lavender_trace_append_text(text, &length, "QSORT DONE n=");
+		lavender_trace_append_decimal(text, &length, a);
+		break;
+	case 4:
+		lavender_trace_append_text(text, &length, "INIT BEGIN upto=");
+		lavender_trace_append_decimal(text, &length, a);
+		lavender_trace_append_text(text, &length, " table_n=");
+		lavender_trace_append_decimal(text, &length, b);
+		break;
+	case 5:
+		lavender_trace_append_text(text, &length, "HOOK idx=");
+		lavender_trace_append_decimal(text, &length, a);
+		lavender_trace_append_text(text, &length, " sub=");
+		lavender_trace_append_decimal(text, &length, b);
+		lavender_trace_append_text(text, &length, " rank=");
+		lavender_trace_append_hex(text, &length, c);
+		lavender_trace_append_text(text, &length, " fn=");
+		lavender_trace_append_hex(text, &length, d);
+		lavender_trace_append_text(text, &length, " arg=");
+		lavender_trace_append_hex(text, &length, e);
+		break;
+	case 6:
+		lavender_trace_append_text(text, &length, "INIT DONE upto=");
+		lavender_trace_append_decimal(text, &length, a);
+		lavender_trace_append_text(text, &length, " table_n=");
+		lavender_trace_append_decimal(text, &length, b);
+		break;
+	case 7:
+		lavender_trace_append_text(text, &length, "SUBSYS LOG BEGIN id=");
+		lavender_trace_append_decimal(text, &length, a);
+		break;
+	case 8:
+		lavender_trace_append_text(text, &length, "SUBSYS LOG DONE id=");
+		lavender_trace_append_decimal(text, &length, a);
+		break;
+	default:
+		lavender_trace_append_text(text, &length, "UNKNOWN STARTUP TRACE");
+		break;
+	}
+	text[length] = '\0';
+
+	/* 1080x2340 display: the final complete 8x16 text row begins at y=2312. */
+	const unsigned int x0 = 24u;
+	const unsigned int y0 = LAVENDER_FB_HEIGHT - LAVENDER_CONSOLE_CHAR_H - 12u;
+	const unsigned int width = LAVENDER_FB_WIDTH - 2u * x0;
+	for (unsigned int gy = 0; gy < LAVENDER_CONSOLE_CHAR_H; gy++) {
+		volatile uint32_t *line = early_fb + (y0 + gy) * LAVENDER_FB_STRIDE + x0;
+		for (unsigned int x = 0; x < width; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+	for (unsigned int index = 0; index < length; index++) {
+		const unsigned char ch = (unsigned char)text[index];
+		const unsigned char *glyph = iso_font + ch * 16u;
+		for (unsigned int gy = 0; gy < LAVENDER_CONSOLE_CHAR_H; gy++) {
+			volatile uint32_t *line = early_fb + (y0 + gy) * LAVENDER_FB_STRIDE + x0 + index * LAVENDER_CONSOLE_CHAR_W;
+			for (unsigned int gx = 0; gx < LAVENDER_CONSOLE_CHAR_W; gx++) {
+				line[gx] = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+			}
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
