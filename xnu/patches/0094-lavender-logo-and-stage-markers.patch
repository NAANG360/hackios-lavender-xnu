diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -751,6 +751,21 @@
  *	SP_EL1 - KVA of CPU's exception stack
  *	TPIDRRO_EL0 - CPU number
  */
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+/* Preserve bootstrap scratch registers while publishing each milestone. */
+.macro lavender_guard_mark value
+	stp	x0, x1, [sp, #-16]!
+	add	x0, x20, x22
+	sub	x0, x0, x23
+	add	x0, x0, #0x1000
+	mov	w1, #\value
+	str	w1, [x0]
+	dc	cvac, x0
+	dsb	sy
+	ldp	x0, x1, [sp], #16
+.endm
+#endif
+
 common_start:
 
 #if HAS_NEX_PG
@@ -900,11 +915,17 @@
 	mov		x0, x5
 #endif
 
-#if !VMAPPLE && !defined(SWEET)
+#if !VMAPPLE && !defined(KERNEL_INTEGRITY_KTRR)
+#if !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
 	bne		.
-#endif /* !VMAPPLE && !SWEET */
+#endif /* !SWEET */
+#endif /* !VMAPPLE && !defined(KERNEL_INTEGRITY_KTRR) */
+
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	lavender_guard_mark 3
+#endif
 
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
 	/* Watchtower
@@ -918,8 +939,16 @@
 	msr		CPACR_EL1, x0
 #endif
 
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	lavender_guard_mark 4
+#endif
+
 	// Clear thread pointer
 	msr		TPIDR_EL1, xzr						// Set thread register
+
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	lavender_guard_mark 5
+#endif
 
 
 #if defined(APPLE_ARM64_ARCH_FAMILY)
@@ -934,6 +963,10 @@
 
 	APPLY_TUNABLES x12, x13, x14
 
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	lavender_guard_mark 6
+#endif
+
 
 #if HAS_CLUSTER
 	// Unmask external IRQs if we're restarting from non-retention WFI
@@ -944,6 +977,10 @@
 
 	// If x21 != 0, we're doing a warm reset, so we need to trampoline to the kernel pmap.
 	cbnz	x21, Ltrampoline
+
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	lavender_guard_mark 7
+#endif
 
 	// Set KVA of boot args as first arg
 	add		x0, x20, x22
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -151,6 +151,55 @@
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)LAVENDER_FB_BASE;
 static volatile uint32_t *early_guard_cell;
 
+static int
+lavender_logo_ellipse(int x, int y, int cx, int cy, int rx, int ry)
+{
+	int64_t dx = x - cx;
+	int64_t dy = y - cy;
+	int64_t rx2 = (int64_t)rx * rx;
+	int64_t ry2 = (int64_t)ry * ry;
+	return dx * dx * ry2 + dy * dy * rx2 <= rx2 * ry2;
+}
+
+/* Draw a diagnostic Apple mark after arm_init has a live framebuffer mapping. */
+void
+sweet_early_logo(void)
+{
+	const int cx = (int)LAVENDER_FB_WIDTH / 2;
+	const int cy = (int)LAVENDER_FB_HEIGHT / 2;
+	const uint32_t black = 0xff000000u;
+	const uint32_t white = 0xffffffffu;
+
+	for (int y = cy - 250; y <= cy + 250; y++) {
+		volatile uint32_t *line = early_fb + y * LAVENDER_FB_STRIDE;
+		for (int x = cx - 190; x <= cx + 190; x++) {
+			line[x] = black;
+		}
+	}
+
+	for (int y = -205; y <= 185; y++) {
+		volatile uint32_t *line = early_fb + (cy + y) * LAVENDER_FB_STRIDE;
+		for (int x = -165; x <= 165; x++) {
+			int body =
+				lavender_logo_ellipse(x, y, -55, -52, 82, 96) ||
+				lavender_logo_ellipse(x, y,  55, -52, 82, 96) ||
+				lavender_logo_ellipse(x, y,   0,  34, 130, 132);
+			int bite = lavender_logo_ellipse(x, y, 132, -8, 46, 55);
+			int dx = x - 37;
+			int dy = y + 164;
+			int u = dx + dy / 2;
+			int v = dy - dx / 2;
+			int leaf = u * u * 256 + v * v * 1444 <= 1444 * 256;
+			int stem = (x >= -2 && x <= 5 && y >= -145 && y <= -117);
+			if ((body && !bite) || leaf || stem) {
+				line[cx + x] = white;
+			}
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+
 void
 sweet_early_guard_init(uintptr_t boot_args_kva)
 {
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -14,6 +14,7 @@
 void sweet_early_disable(void);
 #if defined(ARM64_BOARD_CONFIG_LAVENDER)
 void sweet_early_guard_init(uintptr_t boot_args_kva);
+void sweet_early_logo(void);
 #else
 static inline void sweet_early_guard_init(uintptr_t boot_args_kva) { (void)boot_args_kva; }
 #endif
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -351,6 +351,9 @@
 	sweet_early_guard_init((uintptr_t)args);
 #endif
 	sweet_early_mark(1, "arm_init entered (MMU on)");
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_logo();
+#endif
 
 	arm_setup_pre_sign();
 
