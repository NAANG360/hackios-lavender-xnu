diff --git a/pexpert/pexpert/arm64/LAVENDER.h b/pexpert/pexpert/arm64/LAVENDER.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/pexpert/pexpert/arm64/LAVENDER.h
@@ -0,0 +1,48 @@
+/*
+ * Initial board profile for Redmi Note 7 (lavender), Qualcomm SDM660.
+ *
+ * This is deliberately a compile-time identity/profile only. It does not
+ * describe RAM banks, GIC redistributor addresses, timer PPIs, PMIC routing,
+ * storage, panel power, or touch-controller registers. Those must come from
+ * the device's exact DT/board sources and must not be copied from SWEET.
+ *
+ * SDM660 exposes eight CPUs in two heterogeneous clusters. The target uses
+ * ordinary arm64 code generation; arm64e/PAC is not assumed on Kryo 260.
+ */
+
+#ifndef _PEXPERT_ARM64_LAVENDER_H
+#define _PEXPERT_ARM64_LAVENDER_H
+
+#define NO_MONITOR                1
+#define LAVENDER                  1
+
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+
+/*
+ * XNU 8796/iOS 16 userland is being targeted with 16 KiB pages, as in the
+ * reference iOS 16 port. Hardware granule support still needs confirmation
+ * from ID_AA64MMFR0_EL1 before any Lavender image is boot-tested.
+ */
+#define __ARM_16K_PG__            1
+
+/* The live hardware report identifies GICv3-backed interrupt controllers. */
+#define HAS_GIC_V3                1
+#define GIC_SPURIOUS_IRQ          1023
+#define GICR_PE_SIZE              0x20000
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif
+
+#endif /* _PEXPERT_ARM64_LAVENDER_H */
