-void sweet_early_putc(char c) { (void)c; }
-void sweet_early_panic(const char *fmt, va_list *args) { (void)fmt; (void)args; }
+static volatile unsigned int lavender_early_panicking;
+
+void
+sweet_early_putc(char c)
+{
+	/* This console is valid only after sweet_early_logo() has started it. */
+	if (lavender_console_started) {
+		lavender_console_putc(c);
+	}
+}
+
+void
+sweet_early_panic(const char *fmt, va_list *args)
+{
+	if (!lavender_console_started ||
+	    __atomic_exchange_n(&lavender_early_panicking, 1, __ATOMIC_RELAXED)) {
+		return;
+	}
+	lavender_console_string("\n[DARWIN] PANIC: ");
+	if (fmt != NULL && args != NULL) {
+		va_list copy;
+		va_copy(copy, *args);
+		_doprnt(fmt, &copy, sweet_early_putc, 16);
+		va_end(copy);
+	}
+	sweet_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
