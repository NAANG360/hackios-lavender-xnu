diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -817,8 +817,14 @@
 	uint64_t const *reg;
 	uint32_t const *val;
 	unsigned int size;
+	const char *fbcon_node_name = "sweet-fbcon";
 
-	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess ||
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	/* Lavender's generated ADT uses a target-specific node name. */
+	fbcon_node_name = "lavender-fbcon";
+#endif
+
+	if (SecureDTFindEntry("name", fbcon_node_name, &entry) != kSuccess ||
 	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
 		return;
 	}
@@ -834,9 +840,9 @@
 	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4) {
 		return;
 	}
-	sweet_early_mark(17, "fbcon config read; mapping");
+	sweet_early_mark(18, "fbcon config read; mapping");
 	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
-	sweet_early_mark(18, "fbcon mapping returned");
+	sweet_early_mark(19, "fbcon mapping returned");
 	if (fbcon_base != NULL) {
 		register_serial_functions(&sweet_fbcon_serial_functions);
@@ -923,7 +929,15 @@
 	PE_parse_boot_argn("disable-uart-irq", &disable_uart_irq, sizeof(disable_uart_irq));
 
-	fbcon_probe();
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	/* A boot-arg opt-out lets first boots isolate the fbcon mapping path. */
+	int lavender_no_fbcon = 0;
+	PE_parse_boot_argn("lavender_no_fbcon", &lavender_no_fbcon, sizeof(lavender_no_fbcon));
+	if (!lavender_no_fbcon) {
+		fbcon_probe();
+	}
+#else
+	fbcon_probe();
+#endif
 
 #ifdef PI3_UART
