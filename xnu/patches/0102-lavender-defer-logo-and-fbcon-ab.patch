-	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess ||
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	/* Lavender's generated ADT uses a target-specific node name. */
+	fbcon_node_name = "lavender-fbcon";
