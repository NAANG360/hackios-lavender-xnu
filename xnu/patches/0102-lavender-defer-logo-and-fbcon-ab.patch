@@ -351,11 +351,6 @@
 	sweet_early_guard_init((uintptr_t)args);
 #endif
 	sweet_early_mark(1, "arm_init entered (MMU on)");
-#if defined(ARM64_BOARD_CONFIG_LAVENDER)
-	sweet_early_logo();
-	/* Stage 2 separates arm_init entry from completion of the logo draw. */
-	sweet_early_mark(2, "Lavender diagnostic logo completed");
-#endif
 
 	arm_setup_pre_sign();
 
@@ -532,6 +527,12 @@
 	sweet_early_mark(7, "entering arm_vm_init");
 	arm_vm_init(xmaxmem, args);
 	sweet_early_mark(15, "arm_vm_init returned");
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
