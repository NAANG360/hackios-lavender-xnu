 	if (debug_boot_arg) {
 		patch_low_glo();
@@ -544,9 +545,7 @@
 	PE_consistent_debug_inherit();
 
 	/* Setup debugging output. */
-	sweet_early_mark(16, "calling serial_init");
 	const unsigned int serial_exists = serial_init();
-	sweet_early_mark(19, "serial_init returned");
 	kernel_startup_initialize_upto(STARTUP_SUB_KPRINTF);
 	kprintf("kprintf initialized\n");
 	sweet_early_mark(20, "kprintf startup complete");
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -219,14 +219,22 @@
 		return;
 	}
 	/*
-	 * Publish the arm_init entry and logo-start markers before any framebuffer
-	 * access. If the first display store faults, the A53 guardian must still
-	 * distinguish "arm_init entered" from a pre-MMU/start.s stall.
+	 * Publish early C checkpoints before touching the display. If the
+	 * first framebuffer store faults, the A53 guardian can distinguish an
+	 * arm_init/VM stall from a pre-MMU/start.s stall.
 	 */
 	if (early_guard_cell != 0 && stage <= 2) {
 		*early_guard_cell = stage + 3u;
 		__asm__ volatile("dc cvac, %0; dsb sy" :: "r"(early_guard_cell) : "memory");
 	}
+	/* Keep stages 1-15 framebuffer-silent until the permanent alias exists. */
+	if (stage < 16) {
+		if (early_guard_cell != 0 && stage > 2) {
+			*early_guard_cell = stage + 3u;
+			__asm__ volatile("dc cvac, %0; dsb sy" :: "r"(early_guard_cell) : "memory");
+		}
+		return;
+	}
 	/* A narrow per-stage bar at the bottom edge; no font or IOKit needed. */
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
 	unsigned int x0 = stage * 48u;
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
