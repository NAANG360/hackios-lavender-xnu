+                OSIterator *rpmIterator = OSCollectionIterator::withCollection(rpmNubs);
+                rpmNubs->release();
+                if (rpmIterator != NULL) createNubs(this, rpmIterator);
+            }
+            rpmGlink->release();
+        }
+        soc->release();
