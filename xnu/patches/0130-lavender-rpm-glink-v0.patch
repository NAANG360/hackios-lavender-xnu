diff --git a/iokit/Kernel/arm/LavenderPlatformExpert.cpp b/iokit/Kernel/arm/LavenderPlatformExpert.cpp
--- a/iokit/Kernel/arm/LavenderPlatformExpert.cpp
+++ b/iokit/Kernel/arm/LavenderPlatformExpert.cpp
@@ -11,5 +11,6 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+#include <libkern/c++/OSArray.h>
 
 extern "C" void sweet_early_trace_startup(unsigned int event, uintptr_t a,
     uintptr_t b, uintptr_t c, uintptr_t d, uintptr_t e);
@@ -15,4 +16,5 @@
 #define LAVENDER_PLATFORM_TRACE(event, a, b) \
     sweet_early_trace_startup((event), (uintptr_t)(a), (uintptr_t)(b), 0, 0, 0)
+extern "C" void lavender_register_rpm_glink_driver(void);
 
 class LavenderPlatformExpert : public IODTPlatformExpert {
@@ -39,6 +41,7 @@ LavenderPlatformExpert::start(IOService *provider)
     if (!ok) {
         return false;
     }
+    lavender_register_rpm_glink_driver();
     lavender_register_qup_i2c_driver();
     LAVENDER_PLATFORM_TRACE(151, this, provider);
     registerService();
@@ -72,6 +75,19 @@ LavenderPlatformExpert::processTopLevel(IORegistryEntry *root)
     createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
     LAVENDER_PLATFORM_TRACE(155, root, 0);
 
+    /* rpm-glink is a child of /soc, not /arm-io. Publish only this transport
+     * node; exposing every SoC child here would create unrelated devices. */
+    IORegistryEntry *soc = root->childFromPath("soc", gIODTPlane);
+    if (soc != NULL) {
+        IORegistryEntry *rpmGlink = soc->childFromPath("rpm-glink", gIODTPlane);
+        if (rpmGlink != NULL) {
+            OSArray *rpmNubs = OSArray::withObjects((const OSObject **)&rpmGlink, 1, 1);
+            if (rpmNubs != NULL) createNubs(this, rpmNubs);
+            rpmGlink->release();
+        }
+        soc->release();
+    }
+
     /*
      * No AppleARMIO driver publishes /arm-io children on Lavender. Publish
      * those platform devices directly so any matching built-in/kext driver
diff --git a/iokit/conf/files.arm64 b/iokit/conf/files.arm64
