From: port_ios lavender
Subject: [PATCH 0708] lavender: Vol+ + Vol- hold-to-reboot and tap-to-wake

For Redmi Note 7 units with a broken power button:
- Holding Volume Up + Volume Down for ~3 s drops SDM660 PSHOLD (0x010ac000)
  to trigger a clean hardware reset without draining the battery.
- Quick-tapping Volume Up + Volume Down injects a virtual Power/Side button
  HID event (key 0 down/up) so iOS can wake or lock the display.

diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index b42b53f..bd05797 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -156,6 +156,9 @@ keys_thread(void *arg, wait_result_t result)
 {
 	int state[3] = {0, 0, 0};
 	unsigned errors = 0;
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	unsigned combo_ticks = 0;
+#endif
 	(void)arg;
 	(void)result;
 	for (;;) {
@@ -180,6 +183,30 @@ keys_thread(void *arg, wait_result_t result)
 				sweet_hid_key(k, state[k]);
 			}
 		}
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+		/*
+		 * Broken-power-button support on lavender:
+		 *   - Hold Vol+ + Vol- for ~3 s (150 x 20 ms) -> drop SDM660 PSHOLD (0x010ac000) to reboot.
+		 *   - Quick tap Vol+ + Vol- (< 3 s) -> inject virtual Power button (key 0) to wake/lock.
+		 */
+		if (state[1] && state[2]) {
+			combo_ticks++;
+			if (combo_ticks == 150u) {
+				printf("SWEET KEYS: Vol+ + Vol- held 3 s -> PSHOLD hardware reset\n");
+				vm_offset_t pshold = ml_io_map(0x010ac000u, 0x1000u);
+				if (pshold != 0) {
+					*(volatile uint32_t *)pshold = 0u;
+				}
+			}
+		} else if (combo_ticks > 0u) {
+			if (combo_ticks < 150u) {
+				printf("SWEET KEYS: Vol+ + Vol- tap -> virtual Power wake/lock\n");
+				sweet_hid_key(0, 1);
+				sweet_hid_key(0, 0);
+			}
+			combo_ticks = 0u;
+		}
+#endif
 		keys_wait();
 	}
 }
