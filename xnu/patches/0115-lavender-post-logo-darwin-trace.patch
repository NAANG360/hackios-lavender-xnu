diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -365,6 +365,45 @@ sweet_early_trace_startup(unsigned int event, uintptr_t a, uintptr_t b,
 	case 16:
 		lavender_trace_append_text(text, &length, "HOOK DONE idx=");
 		lavender_trace_append_decimal(text, &length, a);
 		lavender_trace_append_text(text, &length, " sub=");
 		lavender_trace_append_decimal(text, &length, b);
 		lavender_trace_append_text(text, &length, " rank=");
 		lavender_trace_append_hex(text, &length, c);
 		break;
+	case 17:
+		lavender_trace_append_text(text, &length, "KBOOT SCHED BEGIN");
+		break;
+	case 18:
+		lavender_trace_append_text(text, &length, "KBOOT SCHED DONE");
+		break;
+	case 19:
+		lavender_trace_append_text(text, &length, "KBOOT IOKIT BEGIN");
+		break;
+	case 20:
+		lavender_trace_append_text(text, &length, "KBOOT IOKIT DONE");
+		break;
+	case 21:
+		lavender_trace_append_text(text, &length, "KBOOT EARLY BOOT BEGIN");
+		break;
+	case 22:
+		lavender_trace_append_text(text, &length, "KBOOT INTERRUPTS ENABLED");
+		break;
+	case 23:
+		lavender_trace_append_text(text, &length, "KBOOT BSD_INIT BEGIN");
+		break;
+	case 24:
+		lavender_trace_append_text(text, &length, "KBOOT BSD_INIT RETURN");
+		break;
+	case 25:
+		lavender_trace_append_text(text, &length, "BSD VFS INIT DONE");
+		break;
+	case 26:
+		lavender_trace_append_text(text, &length, "BSD ROOT MOUNT BEGIN");
+		break;
+	case 27:
+		lavender_trace_append_text(text, &length, "BSD ROOT MOUNT DONE");
+		break;
+	case 28:
+		lavender_trace_append_text(text, &length, "BSD UTASK BOOTSTRAP BEGIN");
+		break;
+	case 29:
+		lavender_trace_append_text(text, &length, "BSD UTASK BOOTSTRAP RETURN");
+		break;
 	default:
 		lavender_trace_append_text(text, &length, "UNKNOWN STARTUP TRACE");
 		break;
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -570,6 +570,9 @@ kernel_bootstrap_thread(void)
 	kernel_bootstrap_thread_log("idle_thread_create");
 	/*
 	 * Create the idle processor thread.
 	 */
 	idle_thread_create(processor);
 
 	/*
 	 * N.B. Do not stick anything else
@@ -580,7 +583,13 @@ kernel_bootstrap_thread(void)
 	 */
 	kernel_bootstrap_thread_log("sched_startup");
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(17, 0, 0, 0, 0, 0);
+#endif
 	sched_startup();
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(18, 0, 0, 0, 0, 0);
+#endif
 
 	/*
 	 * Thread lifecycle maintenance (teardown, stack allocation)
@@ -647,7 +656,13 @@ kernel_bootstrap_thread(void)
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_init_iokit");
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(19, 0, 0, 0, 0, 0);
+#endif
 	PE_init_iokit();
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(20, 0, 0, 0, 0, 0);
+#endif
 #endif
 
 	assert(ml_get_interrupts_enabled() == FALSE);
@@ -657,7 +672,13 @@ kernel_bootstrap_thread(void)
 	 * Past this point, kernel subsystems that expect to operate with interrupts or preemption enabled may begin enforcement.
 	 */
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(21, 0, 0, 0, 0, 0);
+#endif
 	kernel_startup_initialize_upto(STARTUP_SUB_EARLY_BOOT);
 
 #if SCHED_HYGIENE_DEBUG
@@ -665,7 +686,13 @@ kernel_bootstrap_thread(void)
 	ml_spin_debug_clear_self();
 #endif
 	(void) spllo();         /* Allow interruptions */
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(22, 0, 0, 0, 0, 0);
+#endif
 
 	/*
 	 * This will start displaying progress to the user, start as early as possible
@@ -831,7 +858,13 @@ kernel_bootstrap_thread(void)
 	 */
 	#ifdef  MACH_BSD
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(23, 0, 0, 0, 0, 0);
+#endif
 	bsd_init();
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(24, 0, 0, 0, 0, 0);
+#endif
 #endif
 
 	/*
