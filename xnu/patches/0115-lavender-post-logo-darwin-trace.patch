 			break;
 		}
 		rootdevice[0] = '\0';
 #if CONFIG_NETBOOT
 		if (netboot) {
@@ -1042,11 +1056,17 @@
 	/* Initialize signal state for process 0. */
 	bsd_init_kprintf("calling siginit\n");
 	siginit(kernproc);
 
 	bsd_init_kprintf("calling bsd_utaskbootstrap\n");
