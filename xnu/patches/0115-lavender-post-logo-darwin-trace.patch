diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -377,10 +377,23 @@
 		lavender_trace_append_text(text, &length, " sub=");
 		lavender_trace_append_decimal(text, &length, b);
 		lavender_trace_append_text(text, &length, " rank=");
 		lavender_trace_append_hex(text, &length, c);
 		break;
+	case 17: lavender_trace_append_text(text, &length, "KBOOT SCHED BEGIN"); break;
+	case 18: lavender_trace_append_text(text, &length, "KBOOT SCHED DONE"); break;
+	case 19: lavender_trace_append_text(text, &length, "KBOOT IOKIT BEGIN"); break;
+	case 20: lavender_trace_append_text(text, &length, "KBOOT IOKIT DONE"); break;
+	case 21: lavender_trace_append_text(text, &length, "KBOOT EARLY BOOT BEGIN"); break;
+	case 22: lavender_trace_append_text(text, &length, "KBOOT INTERRUPTS ENABLED"); break;
+	case 23: lavender_trace_append_text(text, &length, "KBOOT BSD_INIT BEGIN"); break;
+	case 24: lavender_trace_append_text(text, &length, "KBOOT BSD_INIT RETURN"); break;
+	case 25: lavender_trace_append_text(text, &length, "BSD VFS INIT DONE"); break;
+	case 26: lavender_trace_append_text(text, &length, "BSD ROOT MOUNT BEGIN"); break;
+	case 27: lavender_trace_append_text(text, &length, "BSD ROOT MOUNT DONE"); break;
+	case 28: lavender_trace_append_text(text, &length, "BSD UTASK BOOTSTRAP BEGIN"); break;
+	case 29: lavender_trace_append_text(text, &length, "BSD UTASK BOOTSTRAP RETURN"); break;
 	default:
 		lavender_trace_append_text(text, &length, "UNKNOWN STARTUP TRACE");
 		break;
 	}
 	text[length] = '\0';
diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -658,11 +658,17 @@
 	 * before this point.
 	 *
 	 * Start up the scheduler services.
 	 */
 	kernel_bootstrap_thread_log("sched_startup");
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(17, 0, 0, 0, 0, 0);
+#endif
 	sched_startup();
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(18, 0, 0, 0, 0, 0);
+#endif
 
 	/*
 	 * Thread lifecycle maintenance (teardown, stack allocation)
 	 */
 	kernel_bootstrap_thread_log("thread_daemon_init");
@@ -733,26 +739,38 @@
 	vm_kernel_addrhash_salt = early_random();
 	vm_kernel_addrhash_salt_ext = early_random();
 
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_init_iokit");
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(19, 0, 0, 0, 0, 0);
+#endif
 	PE_init_iokit();
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(20, 0, 0, 0, 0, 0);
+#endif
 #endif
 
 	assert(ml_get_interrupts_enabled() == FALSE);
 
 	/*
 	 * Past this point, kernel subsystems that expect to operate with
 	 * interrupts or preemption enabled may begin enforcement.
 	 */
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(21, 0, 0, 0, 0, 0);
+#endif
 	kernel_startup_initialize_upto(STARTUP_SUB_EARLY_BOOT);
 
 #if SCHED_HYGIENE_DEBUG
 	// Reset interrupts masked timeout before we enable interrupts
 	ml_spin_debug_clear_self();
 #endif
 	(void) spllo();         /* Allow interruptions */
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(22, 0, 0, 0, 0, 0);
+#endif
 
 	/*
 	 * This will start displaying progress to the user, start as early as possible
 	 */
 	initialize_screen(NULL, kPEAcquireScreen);
@@ -834,11 +852,17 @@
 
 	/*
 	 *	Start the user bootstrap.
 	 */
 #ifdef  MACH_BSD
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(23, 0, 0, 0, 0, 0);
+#endif
 	bsd_init();
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	sweet_early_trace_startup(24, 0, 0, 0, 0, 0);
+#endif
 #endif
 
 
 	/*
 	 * Get rid of pages used for early boot tracing.
