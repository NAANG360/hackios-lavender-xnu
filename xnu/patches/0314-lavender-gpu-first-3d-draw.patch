diff --git a/bsd/dev/lavender_gpu.c b/bsd/dev/lavender_gpu.c
index 4c52458..730bb75 100644
--- a/bsd/dev/lavender_gpu.c
+++ b/bsd/dev/lavender_gpu.c
@@ -1895,6 +1895,520 @@ step20_blit_fill(void)
 	}
 }
 
+/*
+ * Step 21 (M4.3): the first 3D draw. One triangle (TRILIST, 3 vertices from a
+ * vertex buffer) is drawn in sysmem mode (no binning, RB_CNTL BYPASS) into a
+ * 64x64 RGBA8 linear target with a hand-assembled VS (position passes straight
+ * from the fetched r0.xyzw to the output) and FS (four immediate moves into
+ * r0.xyzw, the colour output). State order follows Gallium fd5 (fd5_emit_restore,
+ * emit_sysmem_prep, fd5_program_emit, fd5_emit_state, fd5_draw_emit) as a
+ * behaviour reference, no code taken. The CPU then checks pixels inside the
+ * triangle, outside it, and that the sentinel survives elsewhere.
+ */
+#define D_W 64u
+#define D_H 64u
+#define D_PITCH (D_W * 4u)
+#define D_BYTES (D_PITCH * D_H)
+#define D_COLOUR 0xff9933ffu	/* R 1.0, G 0.2, B 0.6, A 1.0 as RGBA8 */
+#define D_SENTINEL 0xdeadbeefu
+
+static int
+chan_ok(uint32_t got, uint32_t want)
+{
+	for (int s = 0; s < 32; s += 8) {
+		int a = (int)((got >> s) & 0xff), b = (int)((want >> s) & 0xff);
+		if (a - b > 1 || b - a > 1) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* Queue a fence write and wait for it: proves the ME executed everything before it. */
+static int
+draw_mark(const char *what)
+{
+	static uint32_t seq;
+	volatile uint32_t *m = (volatile uint32_t *)(rptr_va + 0x180);
+	uint32_t want = 0xd0000000u | ++seq;
+
+	*m = 0;
+	flush_dcache64((addr64_t)(fence_pa + 0x80), 64, TRUE);
+	ring_pkt7(CP_MEM_WRITE, 3);
+	ring_put((uint32_t)(fence_pa + 0x80));
+	ring_put((uint32_t)((fence_pa + 0x80) >> 32));
+	ring_put(want);
+	ring_submit(what);
+	for (int k = 0; k < 40; k++) {
+		flush_dcache64((addr64_t)(fence_pa + 0x80), 64, TRUE);
+		if (*m == want) {
+			printf("LAVGPU: mark %s ok\n", what);
+			return 0;
+		}
+		lav_wait(5);
+	}
+	printf("LAVGPU: the ME is stuck BEFORE mark %s (fence %08x)\n", what, *m);
+	return -1;
+}
+
+/* mov r1.x/y/z = address lo/hi/value; two (rpt5)nop; stg; (rpt5)nop; end (hand-assembled, as in the compute test) */
+static int
+shader_store_tail(uint32_t *p, int at, uint64_t addr, uint32_t val)
+{
+	shader_mov(&p[at], 4, (uint32_t)addr);
+	shader_mov(&p[at + 2], 5, (uint32_t)(addr >> 32));
+	shader_mov(&p[at + 4], 6, val);
+	p[at + 6] = 0;
+	p[at + 7] = 0x00000500u;
+	p[at + 8] = 0;
+	p[at + 9] = 0x00000500u;
+	p[at + 10] = 0x01800000u | (6u << 1);	/* stg.u32 g[r1.x], r1.z, 1 */
+	p[at + 11] = 0xc0c60100u | (4u << 9);
+	p[at + 12] = 0;
+	p[at + 13] = 0x00000500u;
+	p[at + 14] = 0;
+	p[at + 15] = 0x03000000u;		/* end */
+	return at + 16;
+}
+
+static void
+step21_draw(void)
+{
+	static const uint32_t vtx[3][4] = {
+		{ 0xbf000000u, 0xbf000000u, 0, 0x3f800000u },	/* (-0.5,-0.5) -> px (16,16) */
+		{ 0x3f000000u, 0xbf000000u, 0, 0x3f800000u },	/* ( 0.5,-0.5) -> px (48,16) */
+		{ 0xbf000000u, 0x3f000000u, 0, 0x3f800000u },	/* (-0.5, 0.5) -> px (16,48) */
+	};
+	vm_offset_t va = 0;
+	uint64_t pa = 0, vs_pa, fs_pa, vb_pa, rt_pa;
+	uint32_t *vs, *fs, *vb;
+	volatile uint32_t *rt;
+	uint32_t in_ok = 0, in_n = 0, out_ok = 0, out_n = 0, first_bad = 0xffffffffu;
+	uint32_t pc0[4] = { 0, 0, 0, 0 };
+	const uint32_t hbb = 1;	/* highest bank bit 14 - 13, as the 2D steps use */
+
+	if (ring_va == 0 || ring_pa == 0) {
+		printf("LAVGPU: step 21 needs steps 10-12\n");
+		return;
+	}
+	if (lav_alloc(0x8000, PAGE_MASK, &va, &pa)) {
+		printf("LAVGPU: no pages for the draw\n");
+		return;
+	}
+	vs_pa = pa;
+	fs_pa = pa + 0x1000;
+	vb_pa = pa + 0x2000;
+	rt_pa = pa + 0x3000;
+	vs = (uint32_t *)va;
+	fs = (uint32_t *)(va + 0x1000);
+	vb = (uint32_t *)(va + 0x2000);
+	rt = (volatile uint32_t *)(va + 0x3000);
+
+	/* VS: the position is already in r0.xyzw; it also stores a marker word */
+	shader_store_tail(vs, 0, pa + 0x7000, 0xa5a50002u);
+	/* FS: r0.xyzw = (1.0, 0.2, 0.6, 1.0), and it stores a marker word */
+	shader_mov(&fs[0], 0, 0x3f800000u);
+	shader_mov(&fs[2], 1, 0x3e4ccccdu);
+	shader_mov(&fs[4], 2, 0x3f19999au);
+	shader_mov(&fs[6], 3, 0x3f800000u);
+	shader_store_tail(fs, 8, pa + 0x7040, 0xf5f50001u);
+	for (int i = 0; i < 3; i++) {
+		for (int c = 0; c < 4; c++) {
+			vb[i * 4 + c] = vtx[i][c];
+		}
+	}
+	for (uint32_t i = 0; i < D_W * D_H; i++) {
+		rt[i] = D_SENTINEL;
+	}
+	flush_dcache64((addr64_t)vs_pa, 0x1000, TRUE);
+	flush_dcache64((addr64_t)fs_pa, 0x1000, TRUE);
+	flush_dcache64((addr64_t)vb_pa, 0x1000, TRUE);
+	flush_dcache64((addr64_t)rt_pa, D_BYTES, TRUE);
+
+	lav_announce("step 21: submit the first 3D draw");
+	/* fd5_emit_restore (the non-default part) */
+	ring_pkt7(CP_SET_RENDER_MODE, 5);
+	ring_put(1);						/* BYPASS */
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	if (draw_mark("bypass")) {
+		return;
+	}
+	ring_pkt4(R_UCHE_INVALIDATE_MIN, 5);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0x12);
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_reg(R_HLSQ_UPDATE_CNTL, 0xfffff);
+	if (draw_mark("ucheflush")) {
+		return;
+	}
+	ring_reg(0xe38cu, 0xffffffffu);				/* PC_RESTART_INDEX */
+	ring_reg(0xe388u, 0x12);				/* PC_RASTER_CNTL */
+	ring_pkt4(0xe091u, 2);					/* GRAS_SU_POINT_MINMAX, _SIZE */
+	ring_put(0x4000u | (0x3fffu << 16));			/* min 1.0, max 4092.0 (4.8 fixed) approx */
+	ring_put(0x8);
+	ring_reg(0xe099u, 0);					/* GRAS_SU_CONSERVATIVE_RAS_CNTL */
+	ring_reg(0xe0a4u, 0);					/* GRAS_SC_SCREEN_SCISSOR_CNTL */
+	ring_reg(0xe58au, 0);					/* SP_VS_CONFIG_MAX_CONST */
+	ring_reg(0xe58bu, 0);					/* SP_FS_CONFIG_MAX_CONST */
+	ring_reg(0x0cc6u, 0x40u | (hbb << 1));			/* RB_MODE_CNTL (hbb field at bit 1) */
+	ring_reg(0x0cc4u, 0x100000u);				/* RB_DBG_ECO_CNTL */
+	ring_reg(0x0e42u, 0);					/* VFD_MODE_CNTL */
+	ring_reg(0x0d02u, 0x1f);				/* PC_MODE_CNTL */
+	ring_reg(R_SP_MODE_CNTL, 0x1e);
+	ring_reg(R_SP_DBG_ECO_CNTL, 0x40000800u);
+	ring_reg(R_TPL1_MODE_CNTL, 0x444u | (hbb << 7));
+	ring_pkt4(R_HLSQ_TIMEOUT_0, 2);
+	ring_put(0x80);
+	ring_put(0);
+	ring_reg(0x0e60u, 1u << 10);				/* VPC_DBG_ECO_CNTL: ALLFLATOPTDIS */
+	ring_reg(R_HLSQ_MODE_CNTL, 1);
+	ring_reg(0x0e62u, 0);					/* VPC_MODE_CNTL */
+	ring_reg(0xe0a1u, 0);					/* GRAS_SC_BIN_CNTL */
+	ring_reg(0xe2a0u, 0xff);				/* VPC_FS_PRIMITIVEID_CNTL */
+	ring_reg(0xe21cu, 0);					/* RB_CLEAR_CNTL */
+	if (draw_mark("restore")) {
+		return;
+	}
+	/* emit_sysmem_prep */
+	ring_pkt7(0x1du, 1);					/* CP_SKIP_IB2_ENABLE_GLOBAL */
+	ring_put(0);
+	if (draw_mark("skipib2")) {
+		return;
+	}
+	ring_pkt7(CP_EVENT_WRITE, 1);
+	ring_put(0x19);						/* PC_CCU_INVALIDATE_COLOR */
+	if (draw_mark("ccuinv")) {
+		return;
+	}
+	ring_reg(0xe3b0u, 1);					/* PC_POWER_CNTL: sp cores - 1 */
+	ring_reg(0xe4f0u, 1);					/* VFD_POWER_CNTL */
+	if (draw_mark("power")) {
+		return;
+	}
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_reg(0x0cc7u, 0x10000000u);				/* RB_CCU_CNTL: sysmem (Mesa a5xx) */
+	ring_reg(0xe140u, 1u << 17);				/* RB_CNTL: BYPASS */
+	if (draw_mark("rbcntl")) {
+		return;
+	}
+	ring_pkt4(0xe0eau, 2);					/* GRAS_SC_WINDOW_SCISSOR_TL, BR */
+	ring_put(0);
+	ring_put((D_W - 1) | ((D_H - 1) << 16));
+	ring_pkt4(0xe211u, 2);					/* RB_RESOLVE_CNTL_1, _2 */
+	ring_put(0);
+	ring_put((D_W - 1) | ((D_H - 1) << 16));
+	ring_reg(0xe1d0u, 0);					/* RB_WINDOW_OFFSET */
+	if (draw_mark("winoff")) {
+		return;
+	}
+	ring_reg(0xe2a2u, 0);					/* VPC_SO_OVERRIDE */
+	if (draw_mark("soover")) {
+		return;
+	}
+	ring_pkt7(0x64u, 1);					/* CP_SET_VISIBILITY_OVERRIDE */
+	ring_put(1);
+	if (draw_mark("prep")) {
+		return;
+	}
+	/* emit_mrt (one target, linear RGBA8) and emit_msaa (one sample) */
+	ring_pkt4(0xe152u, 5);					/* RB_MRT_BUF_INFO(0) .. BASE */
+	ring_put(0x30);
+	ring_put(D_PITCH >> 6);					/* PITCH and ARRAY_PITCH are shr 6 */
+	ring_put(D_BYTES >> 6);
+	ring_put((uint32_t)rt_pa);
+	ring_put((uint32_t)(rt_pa >> 32));
+	ring_reg(0xe5d3u, 0x30);				/* SP_FS_MRT_REG(0) */
+	ring_pkt4(0xe704u, 2);					/* TPL1_TP_RAS_MSAA_CNTL, _DEST_ */
+	ring_put(0);
+	ring_put(4);
+	ring_pkt4(0xe142u, 2);					/* RB_RAS_MSAA_CNTL, _DEST_ */
+	ring_put(0);
+	ring_put(4);
+	ring_pkt4(0xe0a2u, 2);					/* GRAS_SC_RAS_MSAA_CNTL, _DEST_ */
+	ring_put(0);
+	ring_put(4);
+	if (draw_mark("mrt")) {
+		return;
+	}
+	/* fd5_emit_state: render targets, blend, depth/stencil, viewport, scissor */
+	ring_reg(0xe147u, 0xf);					/* RB_RENDER_COMPONENTS: RT0 rgba */
+	ring_reg(0xe1a8u, 0);					/* RB_ALPHA_CONTROL */
+	ring_reg(0xe1c0u, 0);					/* RB_STENCIL_CONTROL */
+	ring_pkt4(0xe1c6u, 2);
+	ring_put(0);
+	ring_put(0);
+	ring_reg(0xe1b1u, 0);					/* RB_DEPTH_CNTL */
+	ring_reg(0xe1b0u, 0);					/* RB_DEPTH_PLANE_CNTL */
+	ring_reg(0xe094u, 0);					/* GRAS_SU_DEPTH_PLANE_CNTL */
+	ring_pkt4(0xe0aau, 2);					/* GRAS_SC_SCREEN_SCISSOR_TL_0, BR_0 */
+	ring_put(0);
+	ring_put((D_W - 1) | ((D_H - 1) << 16));
+	ring_pkt7(CP_WAIT_FOR_IDLE, 0);
+	ring_pkt4(0xe010u, 6);					/* GRAS_CL_VPORT X/Y/Z OFFSET, SCALE */
+	ring_put(0x42000000u);					/* x offset 32.0 */
+	ring_put(0x42000000u);					/* x scale 32.0 */
+	ring_put(0x42000000u);					/* y offset 32.0 */
+	ring_put(0x42000000u);					/* y scale 32.0 */
+	ring_put(0);						/* z offset 0 */
+	ring_put(0x3f800000u);					/* z scale 1.0 */
+	ring_pkt4(0xe0cau, 2);					/* GRAS_SC_VIEWPORT_SCISSOR_TL_0, BR_0 */
+	ring_put(0);
+	ring_put((D_W - 1) | ((D_H - 1) << 16));
+	ring_reg(0xe090u, 0);					/* GRAS_SU_CNTL: no culling */
+	ring_pkt4(0xe095u, 3);					/* GRAS_SU_POLY_OFFSET_* */
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_reg(0xe384u, 4);					/* PC_PRIMITIVE_CNTL: STRIDE_IN_VPC 4 */
+	ring_reg(0xe000u, 0);					/* GRAS_CL_CNTL */
+	ring_reg(0xe006u, 0);					/* GRAS_CL_GUARDBAND_CLIP_ADJ */
+	ring_reg(0xe146u, 1);					/* RB_FS_OUTPUT_CNTL: MRT 1 */
+	ring_reg(0xe5cau, 1u | (0xfcu << 5) | (0xfcu << 13));	/* SP_FS_OUTPUT_CNTL */
+	ring_reg(0xe150u, (3u << 3) | (0xfu << 7));		/* RB_MRT_CONTROL(0): ROP_COPY, all comps */
+	ring_reg(0xe151u, 0x10001u);				/* RB_MRT_BLEND_CONTROL(0): src ONE, dst ZERO */
+	ring_reg(0xe5c9u, 0x100);				/* SP_BLEND_CNTL */
+	if (draw_mark("state")) {
+		return;
+	}
+	ring_reg(0xe1a9u, 0xffff0100u);				/* RB_BLEND_CNTL: sample mask, independent */
+	/* fd5_program_emit: VS in the SP, one output (the position), FS writes r0 */
+	ring_pkt4(0xe78bu, 5);					/* HLSQ_VS/FS/HS/DS/GS_CONFIG */
+	ring_put(1);
+	ring_put(1);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_reg(0xe790u, 0);					/* HLSQ_CS_CONFIG */
+	ring_pkt4(0xe791u, 5);					/* HLSQ_VS/FS/HS/DS/GS_CNTL: INSTRLEN 1 << 1 */
+	ring_put(1u << 1);
+	ring_put(1u << 1);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_pkt4(0xe584u, 5);					/* SP_VS/FS/HS/DS/GS_CONFIG */
+	ring_put(1);
+	ring_put(1);
+	ring_put(0);
+	ring_put(0);
+	ring_put(0);
+	ring_reg(R_SP_CS_CONFIG, 0);
+	ring_pkt4(0xe7c3u, 2);					/* HLSQ_VS_CONSTLEN, _INSTRLEN */
+	ring_put(0);
+	ring_put(1);
+	ring_pkt4(0xe7d7u, 2);					/* HLSQ_FS_CONSTLEN, _INSTRLEN */
+	ring_put(0);
+	ring_put(1);
+	ring_reg(0xe590u, (2u << 10) | (1u << 2) | 0x2);	/* SP_VS_CTRL_REG0 */
+	ring_pkt4(0xe294u, 4);					/* VPC_VAR_DISABLE(0..3): no varyings */
+	ring_put(0xffffffffu);
+	ring_put(0xffffffffu);
+	ring_put(0xffffffffu);
+	ring_put(0xffffffffu);
+	ring_reg(0xe593u, 0xf00u);				/* SP_VS_OUT_REG(0): A = r0, mask xyzw */
+	ring_reg(0xe5a3u, 0);					/* SP_VS_VPC_DST_REG(0): OUTLOC0 0 */
+	ring_pkt4(0xe5acu, 2);					/* SP_VS_OBJ_START */
+	ring_put((uint32_t)vs_pa);
+	ring_put((uint32_t)(vs_pa >> 32));
+	if (draw_mark("prog1")) {
+		return;
+	}
+	ring_pkt7(CP_LOAD_STATE4, 3);				/* VS into the SP */
+	ring_put((8u << 18) | (1u << 22) | (2u << 16));
+	ring_put((uint32_t)vs_pa);
+	ring_put((uint32_t)(vs_pa >> 32));
+	ring_reg(0xe385u, 0);					/* PC_PRIM_VTX_CNTL */
+	ring_reg(0xe592u, 1);					/* SP_PRIMITIVE_CNTL: VSOUT 1 */
+	ring_reg(0xe280u, 4u | 0x10000u);			/* VPC_CNTL_0 */
+	ring_pkt4(0xe5c3u, 2);					/* SP_FS_OBJ_START */
+	ring_put((uint32_t)fs_pa);
+	ring_put((uint32_t)(fs_pa >> 32));
+	ring_pkt4(0xe784u, 5);					/* HLSQ_CONTROL_0..4_REG */
+	ring_put(0x880);
+	ring_put(63);
+	ring_put(0xfcfcfcfcu);
+	ring_put(0xfcfcfcfcu);
+	ring_put(0xfcfcfcfcu);
+	ring_reg(0xe5c0u, 0x40002u | (1u << 2) | (2u << 10));	/* SP_FS_CTRL_REG0 */
+	ring_reg(R_HLSQ_UPDATE_CNTL, 0x20fffffu);
+	ring_reg(0xe298u, 0xffffu);				/* VPC_GS_SIV_CNTL */
+	ring_reg(R_SP_SP_CNTL, 0x10);
+	ring_reg(0xe005u, 0);					/* GRAS_CNTL */
+	ring_pkt4(0xe144u, 2);					/* RB_RENDER_CONTROL0, 1 */
+	ring_put(0);
+	ring_put(0);
+	ring_pkt4(0xe5cbu, 8);					/* SP_FS_OUTPUT_REG(0..7): colour in r0 */
+	ring_put(0);
+	for (int i = 1; i < 8; i++) {
+		ring_put(0xfc);
+	}
+	ring_reg(0xe29du, 0xff00u);				/* VPC_PACK: NUMNONPOSVAR 0, PSIZELOC off */
+	ring_pkt4(0xe282u, 8);					/* VPC_VARYING_INTERP_MODE(0..7) */
+	for (int i = 0; i < 8; i++) {
+		ring_put(0);
+	}
+	ring_pkt4(0xe28au, 8);					/* VPC_VARYING_PS_REPL_MODE(0..7) */
+	for (int i = 0; i < 8; i++) {
+		ring_put(0);
+	}
+	ring_reg(0xe001u, 0);					/* GRAS_VS_CL_CNTL */
+	ring_reg(0xe29au, 0);					/* VPC_CLIP_CNTL */
+	ring_reg(0xe389u, 0);					/* PC_CLIP_CNTL */
+	ring_pkt7(CP_LOAD_STATE4, 3);				/* FS into the SP */
+	ring_put((0xcu << 18) | (1u << 22) | (2u << 16));
+	ring_put((uint32_t)fs_pa);
+	ring_put((uint32_t)(fs_pa >> 32));
+	if (draw_mark("prog2")) {
+		return;
+	}
+	ring_pkt4(0xe401u, 5);					/* VFD_CONTROL_1..5 */
+	ring_put(0xfcu | (0xfcu << 8) | 0xfc0000u);
+	ring_put(0xfcfcu);
+	ring_put(0xfcfcu);
+	ring_put(0xfcu);
+	ring_put(0);
+	/* fd5_emit_vertex_bufs: one fetch, float4 into r0.xyzw */
+	ring_pkt4(0xe40au, 4);					/* VFD_FETCH(0) */
+	ring_put((uint32_t)vb_pa);
+	ring_put((uint32_t)(vb_pa >> 32));
+	ring_put(48);
+	ring_put(16);
+	ring_pkt4(0xe48au, 2);					/* VFD_DECODE(0) */
+	ring_put(0u | (0x82u << 20) | (1u << 30) | (1u << 31));
+	ring_put(1);
+	ring_reg(0xe4cau, 0xfu | (0u << 4));			/* VFD_DEST_CNTL(0): xyzw -> r0 */
+	ring_reg(0xe400u, 1);					/* VFD_CONTROL_0: VTXCNT 1 */
+	ring_pkt4(0xe408u, 2);					/* VFD_INDEX_OFFSET, _INSTANCE_START_OFFSET */
+	ring_put(0);
+	ring_put(0);
+	ring_reg(0xe38cu, 0xffffffffu);				/* PC_RESTART_INDEX */
+	/* fd5_emit_render_cntl and the draw */
+	if (draw_mark("vtx")) {
+		return;
+	}
+	/* RB perf counters: 0 TOTAL_PASS, 1 C_WRITE, 2 STALL_CYCLES_CCU, 3 BUSY_CYCLES */
+	wr(gpu, 0x0464u * 4, 1);
+	wr(gpu, 0x0cd0u * 4, 17);
+	wr(gpu, 0x0cd1u * 4, 16);
+	wr(gpu, 0x0cd2u * 4, 1);
+	wr(gpu, 0x0cd3u * 4, 0);
+	for (int var = 0; var < 4; var++) {
+		static const uint32_t rc_var[4] = { 0x8, 0, 0x8, 0 };
+		static const uint32_t sc_var[4] = { 0x8, 0x8, 0, 0 };
+		static const uint32_t ccu_var[4] = { 0x08000000u, 0x08000000u, 0x08000000u, 0x04000000u };
+		in_ok = in_n = out_ok = out_n = 0;
+		first_bad = 0xffffffffu;
+		printf("LAVGPU: draw variant %d: RB_RENDER_CNTL %x GRAS_SC_CNTL %x\n", var,
+		    rc_var[var], sc_var[var]);
+		for (uint32_t i = 0; i < D_W * D_H; i++) {
+			rt[i] = D_SENTINEL;
+		}
+		flush_dcache64((addr64_t)rt_pa, D_BYTES, TRUE);
+		*(volatile uint32_t *)(va + 0x7000) = 0;
