diff --git a/osfmk/arm64/lavender_early.c b/osfmk/arm64/lavender_early.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/lavender_early.c
@@ -0,0 +1,71 @@
+/*
+ * First Lavender XNU-owned display mark.
+ *
+ * This runs from arm_init(), after the bootstrap MMU is enabled and before
+ * platform setup. start.s installs a temporary Normal-NC mapping for the
+ * two 32MB blocks containing the audited splash framebuffer. This is a
+ * one-shot bring-up mark, not a complete framebuffer or display driver.
+ */
+#include <arm64/lavender_early.h>
+
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+#include <stdint.h>
+
+#define LAVENDER_FB       ((volatile uint32_t *)(uintptr_t)0x9d400000ULL)
+#define LAVENDER_WIDTH    1080u
+#define LAVENDER_HEIGHT   2340u
+#define LAVENDER_STRIDE   1080u
+#define LOGO_GRID         64
+#define LOGO_SCALE        8
+
+static int
+inside_ellipse(int x, int y, int cx, int cy, int rx, int ry)
+{
+	int dx = x - cx;
+	int dy = y - cy;
+	return dx * dx * ry * ry + dy * dy * rx * rx <= rx * rx * ry * ry;
+}
+
+static int
+apple_pixel(int x, int y)
+{
+	int body = inside_ellipse(x, y, 24, 31, 14, 17) ||
+	    inside_ellipse(x, y, 40, 31, 14, 17) ||
+	    inside_ellipse(x, y, 32, 42, 19, 12);
+	int bite = inside_ellipse(x, y, 49, 18, 9, 9);
+	int bottom_notch = y > 51 && x > 28 && x < 36;
+	int stem = x >= 31 && x <= 34 && y >= 11 && y <= 20;
+	int leaf = inside_ellipse(x, y, 41, 7, 8, 4);
+	return (body && !bite && !bottom_notch) || stem || leaf;
+}
+
+void
+lavender_early_logo(void)
+{
+	volatile uint32_t *fb = LAVENDER_FB;
+	for (uint32_t y = 0; y < LAVENDER_HEIGHT; y++) {
+		volatile uint32_t *line = fb + y * LAVENDER_STRIDE;
+		for (uint32_t x = 0; x < LAVENDER_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+
+	const int scale = LOGO_SCALE;
+	const int left = ((int)LAVENDER_WIDTH - LOGO_GRID * scale) / 2;
+	const int top = ((int)LAVENDER_HEIGHT - LOGO_GRID * scale) / 2;
+	for (int gy = 0; gy < LOGO_GRID; gy++) {
+		for (int gx = 0; gx < LOGO_GRID; gx++) {
+			if (!apple_pixel(gx, gy)) {
+				continue;
+			}
+			for (int sy = 0; sy < scale; sy++) {
+				volatile uint32_t *line = fb + (top + gy * scale + sy) * LAVENDER_STRIDE + left + gx * scale;
+				for (int sx = 0; sx < scale; sx++) {
+					line[sx] = 0xffffffffu;
+				}
+			}
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* ARM64_BOARD_CONFIG_LAVENDER */
