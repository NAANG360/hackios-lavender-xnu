diff --git a/osfmk/kern/lock_mtx.c b/osfmk/kern/lock_mtx.c
--- a/osfmk/kern/lock_mtx.c
+++ b/osfmk/kern/lock_mtx.c
@@ -250,6 +250,12 @@
 
 #pragma mark lck_mtx_t: alloc/init/destroy/free
 
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+extern bool lavender_startup_trace_enabled;
+extern void sweet_early_trace_startup(unsigned int event, uintptr_t a,
+    uintptr_t b, uintptr_t c, uintptr_t d, uintptr_t e);
+#endif
+
 lck_mtx_t *
 lck_mtx_alloc_init(lck_grp_t *grp, lck_attr_t *attr)
 {
@@ -271,6 +277,10 @@
 void
 lck_mtx_init(lck_mtx_t *lck, lck_grp_t *grp, lck_attr_t *attr)
 {
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	if (lavender_startup_trace_enabled) {
+		sweet_early_trace_startup(9, (uintptr_t)lck, (uintptr_t)grp, (uintptr_t)attr, 0, 0);
+	}
+#endif
 	if (attr == LCK_ATTR_NULL) {
 		attr = &lck_attr_default;
 	}
@@ -282,7 +292,19 @@
 		lck->lck_mtx.data |= LCK_MTX_PROFILE;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	if (lavender_startup_trace_enabled) {
+		sweet_early_trace_startup(10, (uintptr_t)lck, (uintptr_t)grp, 0, 0, 0);
+		sweet_early_trace_startup(11, (uintptr_t)grp,
+		    (uintptr_t)&grp->lck_grp_mtxcnt, 0, 0, 0);
+	}
+#endif
 	lck_grp_reference(grp, &grp->lck_grp_mtxcnt);
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	if (lavender_startup_trace_enabled) {
+		sweet_early_trace_startup(15, (uintptr_t)lck, (uintptr_t)grp, 0, 0, 0);
+	}
+#endif
 }
diff --git a/osfmk/kern/lock_group.c b/osfmk/kern/lock_group.c
--- a/osfmk/kern/lock_group.c
+++ b/osfmk/kern/lock_group.c
@@ -270,13 +270,29 @@
 void
 lck_grp_reference(lck_grp_t *grp, uint32_t *cnt)
 {
+	#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	extern bool lavender_startup_trace_enabled;
+	extern void sweet_early_trace_startup(unsigned int event, uintptr_t a,
+	    uintptr_t b, uintptr_t c, uintptr_t d, uintptr_t e);
+	if (lavender_startup_trace_enabled) {
+		sweet_early_trace_startup(12, (uintptr_t)grp, (uintptr_t)cnt, 0, 0, 0);
+	}
+	#endif
 	if (cnt) {
 		os_atomic_inc(cnt, relaxed);
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+		if (lavender_startup_trace_enabled) {
+			sweet_early_trace_startup(13, (uintptr_t)grp, (uintptr_t)cnt,
+			    (uintptr_t)*cnt, 0, 0);
+		}
+#endif
 	}
 	if (grp->lck_grp_attr_id & LCK_GRP_ATTR_ALLOCATED) {
 		os_ref_retain_raw(&grp->lck_grp_refcnt, NULL);
 	}
+#if defined(ARM64_BOARD_CONFIG_LAVENDER)
+	if (lavender_startup_trace_enabled) {
+		sweet_early_trace_startup(14, (uintptr_t)grp, (uintptr_t)cnt,
+		    (uintptr_t)grp->lck_grp_attr_id, 0, 0);
+	}
+#endif
 }
