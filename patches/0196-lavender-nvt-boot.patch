+/* Raw two-byte Novatek command (register, value) at the bootloader. */
+static int
+nvt_write_cmd(uint8_t addr, uint8_t reg, uint8_t value)
+{
+	int ok = 1;
+
+	i2c_start();
+	ok &= i2c_write((uint8_t)(addr << 1));
+	ok &= i2c_write(reg);
+	ok &= i2c_write(value);
+	i2c_stop();
+	return ok ? 0 : EIO;
+}
+
